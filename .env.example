# Copy to .env and fill values. Never commit .env.

ENVIRONMENT=development

# REQUIRED in production — long random string (32+ chars)
AUTH_JWT_SECRET=

AUTH_JWT_HOURS=72
# Keep false after the first admin is created
AUTH_ALLOW_SIGNUP=false

# Comma-separated exact origins (no trailing slash)
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

DATA_DIR=data

# Optional hosted Postgres (service role stays on this host only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
